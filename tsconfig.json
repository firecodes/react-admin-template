{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["DOM", "es2022"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,

    // 配置路径别名
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
